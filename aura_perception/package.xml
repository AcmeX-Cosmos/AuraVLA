<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aura_perception</name>
  <version>1.0.0</version>
  <description>AuraVLA perception module for scene understanding and task evaluation</description>

  <maintainer email="AcmeX@foxmail.com">AuraVLA Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>aura_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <exec_depend>aura_camera_bridge</exec_depend>
  <exec_depend>aura_execution</exec_depend>
  <exec_depend>aura_isaac_bridge</exec_depend>
  <exec_depend>aura_orchestration</exec_depend>
  <exec_depend>aura_planning</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
